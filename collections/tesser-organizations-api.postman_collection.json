        {
          "id": "47a1c4f0-c9cd-4775-8708-8f81f799f5bc",
          "name": "Create or update an organization secret",
          "request": {
            "name": "Create or update an organization secret",
            "description": {
              "content": "Store a secret (e.g., API key) securely in the vault for the authenticated user's organization.\n\nSecrets are stored at the organization level and shared across all workspaces within the organization.\n\nCurrently supported providers:\n- **CIRCLE_MINT**: Circle Mint API key for payment processing\n- **OPENFX**: OpenFX credentials bundle (orgId, apiKey, privateKey, webhookSecret)\n- **CIRCLE_PAYMENTS_NETWORK**: Circle Payments Network (CPN) API key, validated by creating a CPN webhook subscription\n\nThe secret is encrypted and stored in Basis Theory vault. Only a masked version is returned.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "organizations",
                "secrets"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
