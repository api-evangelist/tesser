                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"<string>\",\n  \"key\": \"<string>\",\n  \"value\": \"<string>\"\n}",
              "options": {
