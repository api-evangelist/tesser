{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tesser Accounts health API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "health",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Health check endpoint",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/health"
          },
          "docs": "Health check endpoint"
        },
        {
          "info": {
            "name": "Root health check",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/"
          },
          "docs": "Root health check"
        }
      ]
    }
  ],
  "bundled": true
}