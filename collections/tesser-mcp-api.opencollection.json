{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tesser Accounts MCP API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "MCP",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "MCP Server",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/mcp"
          },
          "docs": "Model Context Protocol endpoint for AI agent tool discovery and invocation"
        }
      ]
    }
  ],
  "bundled": true
}