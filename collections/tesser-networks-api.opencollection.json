{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tesser Accounts Networks API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Networks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get available networks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/networks",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve list of all supported blockchain networks. Returns an object with a data array containing network key and display name."
        }
      ]
    }
  ],
  "bundled": true
}