{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tesser Accounts Users API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get current user profile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/users/me",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve the authenticated user's profile information including user details and team/organization information."
        },
        {
          "info": {
            "name": "Sign up a new user and create a team",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/users/signup",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Sign up a new user and create a team"
        }
      ]
    }
  ],
  "bundled": true
}